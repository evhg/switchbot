# Copy to supabase/functions/.env for `supabase functions serve`; push to the project with
# `supabase secrets set --env-file supabase/functions/.env`. Never commit the real file.
# Optional: pg_cron is verified against the Vault secret cron_secret (migration 0002). Set this only to call
# cron-protected functions by hand with a secret you know.
CRON_SECRET=
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
METER_DEVICE_ID=
AC_DEVICE_ID=
WEBHOOK_SECRET=
DRY_RUN=true
SWITCHBOT_DAILY_BUDGET=5000
SWITCHBOT_AC_RESERVE=300
DEFAULT_LIGHTS_OUT=22:30
DEFAULT_WAKE=06:30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HEALTH_WEBHOOK_SECRET=
GOOGLE_HEALTH_SIGNATURE=log
OAUTH_START_SECRET=
APP_URL=
# Optional: Google Weather API key for weather-poll (without it: Open-Meteo, no key). WEATHER_LAT / WEATHER_LON
# default to Phuket (7.88 / 98.39).
GOOGLE_WEATHER_API_KEY=
WEATHER_LAT=
WEATHER_LON=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
